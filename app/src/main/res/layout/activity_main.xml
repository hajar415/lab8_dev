<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/labelEtat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="État : en attente"
        android:textSize="15sp"
        android:textColor="#333333"
        android:paddingBottom="14dp"/>

    <ProgressBar
        android:id="@+id/barreProgression"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:progressTint="#4CAF50"
        android:visibility="invisible"/>

    <ImageView
        android:id="@+id/imageAffichee"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginTop="18dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="aperçu image"/>

    <Button
        android:id="@+id/btnThread"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Charger via Thread"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:layout_marginTop="18dp"/>

    <Button
        android:id="@+id/btnAsyncTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lancer calcul AsyncTask"
        android:backgroundTint="#009688"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnNotification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tester réactivité UI"
        android:backgroundTint="#FF5722"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp"/>

</LinearLayout>